{
  "buildCommand": "pnpm install --no-frozen-lockfile && next build --webpack",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "functions": {
    "app/api/cron/poll-did-videos/route.ts": {
      "memory": 3008,
      "maxDuration": 300,
      "includeFiles": "node_modules/ffmpeg-static/**"
    },
    "app/api/internal/remotion/render-just-listed/route.ts": {
      "memory": 3008,
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium-min/**"
    },
    "app/api/cron/listing-promo-hybrid-composite/route.ts": {
      "memory": 3008,
      "maxDuration": 300,
      "includeFiles": "node_modules/ffmpeg-static/**"
    },
    "app/api/internal/remotion/render-newsletter-video/route.ts": {
      "memory": 3008,
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium-min/**"
    },
    "app/api/internal/remotion/render-composition/route.ts": {
      "memory": 3008,
      "maxDuration": 300,
      "includeFiles": "node_modules/{@sparticuz/chromium-min,ffmpeg-static}/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/dispatch",
      "schedule": "* * * * *"
    }
  ]
}
