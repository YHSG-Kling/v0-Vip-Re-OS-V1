    },
    {
      "path": "/api/cron/lead-scraping",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/contact-enrichment",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/poll-heygen-videos",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/onboarding-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/calendar-sync",
      "schedule": "0 */2 * * *"
