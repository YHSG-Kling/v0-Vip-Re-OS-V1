# @zoom/meetingsdk@6.2.0 pins react@18.2.0 as a peer while the app runs React 19.
# Only its framework-agnostic embedded entry (@zoom/meetingsdk/embedded) is ever
# imported (sim-locked in scripts/zoom-embed-simulator.ts), so the React peer is
# irrelevant at runtime — but `npm ci` enforces peers strictly. This keeps CI
# resolving exactly the way the lockfile was generated.
legacy-peer-deps=true
