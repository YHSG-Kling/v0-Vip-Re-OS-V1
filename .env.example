# ── Real estate data / property providers ───────────────────────────────
# BatchData token strategy (lib/external/batchdata-tokens.ts, wave 67): billing is
# per RECORD against whatever datasets the calling TOKEN is provisioned for, and an
# account may hold multiple independently-provisioned server-side tokens. The three
# overrides below are OPTIONAL — each falls back to BATCHDATA_API_KEY when unset, so
# a deployment that never provisions the narrower tokens keeps working unchanged on
# one key. Provisioning a separate token per purpose keeps a lane's per-record cost
# down to only the datasets it actually reads, and makes a runaway lane's spend
# attributable to the token that caused it (BatchData's own dashboard bills per token).
BATCHDATA_API_KEY=
# Skip-trace is billed pay-as-you-go (~$0.06/matched record per the wave-67 research)
# — a dedicated token isolates that per-record cost from the search lane's token.
BATCHDATA_SKIP_TRACE_TOKEN=
# Listing/property-lookup hydration (Smart Search hydrate, active-listing discovery)
# — a dedicated token isolates listing-dataset provisioning from search.
BATCHDATA_LISTING_TOKEN=
# https://mcp.batchdata.com is the default when unset — only override to point at a
# sandbox or an account-specific MCP endpoint.
BATCHDATA_MCP_URL=
# Bearer token for the MCP server (falls back to BATCHDATA_API_KEY) — an OAuth MCP
# token honors an ACCOUNT-LEVEL dataset config (app.batchdata.com/api-tokens/mcp-
# oauth-config; defaults to Core Tax Assessor only, all add-ons off), while a
# server-side token keeps its own provisioning — provision this one narrowly for
# whichever MCP tools the agent surfaces actually need.
BATCHDATA_MCP_AUTH=
BATCHDATA_SMART_SEARCH_WEBHOOK_SECRET=
BATCHDATA_SMART_SEARCH_WEBHOOK_URL=
# BatchRank (wave 68, lib/external/batchdata-batchrank.ts) — an OPTIONAL, CUSTOM-PRICED
# AI sale-propensity score per property (High/Medium/Low). It is a ranking add-on ON TOP
# of the investor off-market candidates Property Search already returns — it is NOT how
# candidates are found (that is quickList + valuation.estimatedValue + equityPercent +
# general.propertyTypeDetail filters, see fetchIncrementalPropertySearch). CONTACT
# BATCHDATA SALES to get pricing and a token before enabling. Fails closed (candidates
# pass through unranked) unless BOTH vars below are set — leaving either unset is the
# safe default and costs nothing.
BATCHDATA_BATCHRANK_ENABLED=false
BATCHDATA_BATCHRANK_TOKEN=
HOUSECANARY_API_KEY=
HOUSECANARY_API_SECRET=
RENTCAST_API_KEY=
IDXBROKER_API_KEY=
IDXBROKER_API_URL=
MLS_API_KEY=
MLS_API_ENDPOINT=
ZILLOW_API_KEY=
REDFIN_API_KEY=
REALTOR_API_KEY=
TRULIA_API_KEY=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
MAPBOX_TOKEN=
PEOPLEDATA_API_KEY=
PEXELS_API_KEY=
APIFY_API_KEY=
APIFY_API_TOKEN=
APIFY_TOKEN=
ZENROWS_API_KEY=
# Zyte API (lib/external/zyte-client.ts) — fallback scraper for Zillow/Realtor.com/Homes.com
# saved-search + "contact agent" chatter when ZenRows is unconfigured or fails on a target;
# see docs/lead-acquisition-coverage-2026-09.md for the provider verdict. The OS picks by
# configured key: ZENROWS_API_KEY first, ZYTE_API_KEY as fallback, fails closed (no scrape)
# when neither is set.
ZYTE_API_KEY=

