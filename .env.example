# .env.example
#
# Generated by scripts/env-var-parity.ts (wave 57, unread-state / env-var
# sweep) — every name is `process.env.X` read somewhere under app/ or lib/
# with no prior documented source (no .env.example, no vercel.json "env"
# key, no ALL_CAPS `KEY:` line in .github/workflows/*.yml). Values are
# deliberately blank: this file records WHICH names the app reads, not what
# they should be set to. Re-run `npx tsx scripts/env-var-parity.ts` after
# adding a new `process.env.*` read anywhere in the app — a name missing
# from this file is exactly what that guard fails on.
#
# A handful of names below are platform-provided (Vercel/Node/AWS Lambda set
# them automatically at runtime) and are listed for completeness only — see
# the inline note on each; nothing needs to be typed in for those.

# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Core app ─────────────────────────────────────────────────────────────
# NODE_ENV — platform-provided (set by `next dev`/`next build`/the test
# runner); listed for completeness, never hand-set here.
NODE_ENV=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BROKERAGE_ID=
NEXT_PUBLIC_DEMO_MODE=
NEXT_PUBLIC_DEMO_PASSWORD=
CRON_SECRET=
CRON_DISPATCH_BASE_URL=
INTERNAL_API_SECRET=
ADMIN_MAINTENANCE_KEY=
ALLOW_PROD_MAINTENANCE_ROUTES=
SECRETS_ENCRYPTION_KEY=
AGENT_ASSISTANT_TOOL_SECRET=
WORKFLOW_WEBHOOK_SECRET=
COLLABORATIVE_SEARCH_ENABLED=

# ── Feature flags (NEXT_PUBLIC_, read client-side) ──────────────────────
