# ── Vercel platform (custom domains + deploy metadata) ──────────────────
# VERCEL_ENV / VERCEL_URL / VERCEL_DEPLOYMENT_ID / VERCEL_GIT_COMMIT_SHA /
# VERCEL_PROJECT_PRODUCTION_URL — platform-provided at runtime on Vercel;
# nothing to set locally. VERCEL_PROJECT_ID / VERCEL_TEAM_ID / VERCEL_TOKEN
# ARE configured secrets — they let the app call the Vercel API itself
# (lib/platform/custom-domains.ts, white-label domains).
VERCEL_ENV=
VERCEL_URL=
VERCEL_DEPLOYMENT_ID=
VERCEL_GIT_COMMIT_SHA=
VERCEL_PROJECT_PRODUCTION_URL=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TOKEN=
