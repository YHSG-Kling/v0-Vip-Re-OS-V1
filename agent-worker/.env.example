# Required — same LiveKit project that the Next.js app issues tokens for.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Required — STT / LLM / TTS providers used by the voice pipeline.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Optional — fallback voice when the room metadata doesn't carry a clone id.
ELEVENLABS_DEFAULT_VOICE_ID=

# Optional — override the default assistant persona prompt.
AGENT_SYSTEM_PROMPT=
